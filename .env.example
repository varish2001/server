NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai_virtual_gym
JWT_SECRET=replace_with_a_long_random_secret
OPENAI_API_KEY=your_openai_api_key
OPENAI_PLAN_MODEL=gpt-4o-mini
CLIENT_URL=http://localhost:5173
# Set CLIENT_URL=https://client0-seven.vercel.app in Render.
# Optional comma-separated list of additional explicitly trusted origins (origins only, no paths)
CLIENT_URLS=http://localhost:4173,http://127.0.0.1:4173
