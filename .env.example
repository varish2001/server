NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai_virtual_gym
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
OPENAI_API_KEY=your_openai_api_key
OPENAI_PLAN_MODEL=gpt-4o-mini
CLIENT_URL=http://localhost:5173

# Production Render Configuration:
# Set NODE_ENV=production
# Set CLIENT_URL=https://client0-seven.vercel.app
# Optional comma-separated list of additional explicitly trusted origins:
# CLIENT_URLS=http://localhost:5173,http://localhost:4173
